# Variables públicas (expuestas al cliente vía import.meta.env — prefijo obligatorio "PUBLIC_").
# Ninguna es requerida para `npm run dev` / `npm run build`; el sitio funciona sin backend.

# Ruta base del sitio. Dejar vacío ("/") con dominio propio; usar "/nombre-del-repo"
# solo en un GitHub Pages de proyecto sin dominio personalizado.
PUBLIC_BASE_PATH=/

# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX). Vacío = gtag.js no
# se carga (así los builds locales/preview no ensucian las métricas de producción).
# El valor real solo se define en las variables de entorno de Cloudflare Pages
# (Production), nunca en este archivo ni en un .env commiteado.
PUBLIC_GA_MEASUREMENT_ID=

# Endpoint de Formspree al que envía ContactForm.astro (formato
# https://formspree.io/f/xxxxxxxx). Solución temporal mientras se monta el
# correo corporativo en Zoho — ver CLAUDE.md § Historial de decisiones.
# Vacío = el formulario no envía nada (falla silenciosamente al hacer submit).
PUBLIC_CONTACT_ENDPOINT=
