# Copiar a `.env` (ignorado por git) y completar. Un solo archivo sirve para las dos
# piezas del proyecto:
#   - Astro (npm run dev / build) lee las variables PUBLIC_* en tiempo de build.
#   - wrangler (npm run dev:cf) lee TODO el .env y se lo pasa a la Pages Function
#     functions/api/contact.ts como `env` — ahí es donde viven los secretos.
# En producción NO se usa este archivo: los mismos nombres se definen en Cloudflare
# Pages → Settings → Variables and Secrets (ver CLAUDE.md § Formulario de contacto).
# Ninguna es requerida para `npm run dev` / `npm run build`.

# ── Públicas (terminan en el HTML/JS que recibe el navegador) ─────────────────

# Ruta base del sitio. Dejar vacío ("/") con dominio propio; usar "/nombre-del-repo"
# solo en un GitHub Pages de proyecto sin dominio personalizado.
PUBLIC_BASE_PATH=/

# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX). Vacío = gtag.js no
# se carga (así los builds locales/preview no ensucian las métricas de producción).
# El valor real solo se define en las variables de entorno de Cloudflare Pages
# (Production), nunca en este archivo ni en un .env commiteado.
PUBLIC_GA_MEASUREMENT_ID=

# Site key del widget de Turnstile (antispam de Cloudflare). Es pública por diseño.
# Local: clave de prueba oficial de Cloudflare que siempre pasa. Producción: la del
# widget real creado en el dashboard de Cloudflare → Turnstile.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── Secretas (solo las lee la Pages Function, nunca llegan al navegador) ──────
# Sin prefijo PUBLIC_ a propósito: Astro nunca las incluye en el bundle del cliente.

# Clave secreta de Turnstile. Local: clave de prueba que siempre valida (va en
# pareja con la site key de prueba de arriba). Producción: tipo "Secret".
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# API key de Resend (https://resend.com/api-keys). Producción: tipo "Secret".
RESEND_API_KEY=

# Remitente. Debe ser de un dominio verificado en Resend (producción:
# "Siscodex Web <web@siscodex.com>"). Para probar en local antes de verificar el
# dominio, Resend permite "onboarding@resend.dev", que solo entrega al correo con
# el que se creó la cuenta de Resend.
CONTACT_FROM="Siscodex Web <onboarding@resend.dev>"

# Destinatarios de la notificación, separados por coma.
CONTACT_TO=contacto@siscodex.com
