---
import { Icon } from "astro-icon/components";
import { withBase } from "@/utils/url";
import { localizedHref } from "@/i18n/utils";
import { DEFAULT_LOCALE, type Locale } from "@/i18n/types";
import type { IconName } from "@/types";

type Variant = "primary" | "secondary" | "ghost";
type Size = "md" | "lg";

interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  target?: string;
  rel?: string;
  variant?: Variant;
  size?: Size;
  icon?: IconName;
  iconPosition?: "left" | "right";
  class?: string;
}

const {
  variant = "primary",
  size = "md",
  icon,
  iconPosition = "right",
  class: className,
  href,
  type,
  target,
  rel,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-md font-medium tracking-tight transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-400 disabled:opacity-50 disabled:pointer-events-none";

const variants: Record<Variant, string> = {
  primary:
    "bg-brand-400 text-ink-950 hover:bg-brand-300 shadow-[0_0_0_1px_rgba(255,255,255,0.05),0_6px_18px_-8px_rgba(16,185,129,0.45)] hover:shadow-[0_0_0_1px_rgba(255,255,255,0.08),0_8px_22px_-6px_rgba(16,185,129,0.55)]",
  secondary:
    "border border-ink-500 text-ink-50 hover:border-brand-400 hover:text-brand-300 bg-ink-800/40",
  ghost: "text-ink-200 hover:text-brand-300",
};

const sizes: Record<Size, string> = {
  md: "px-5 py-2.5 text-sm",
  lg: "px-7 py-3.5 text-base",
};

const classes = [base, variants[variant], sizes[size], className].filter(Boolean).join(" ");
const Tag = href ? "a" : "button";
const locale = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const resolvedHref = href ? withBase(localizedHref(href, locale)) : undefined;
---

<Tag class={classes} href={resolvedHref} type={href ? undefined : type ?? "button"} target={target} rel={rel}>
  {icon && iconPosition === "left" && <Icon name={`lucide:${icon}`} class="size-4" />}
  <slot />
  {icon && iconPosition === "right" && <Icon name={`lucide:${icon}`} class="size-4" />}
</Tag>
