---
import TeamCard from "@/components/sections/TeamCard.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { getTeam } from "@/data/team";
import { useTranslations } from "@/i18n/utils";
import { DEFAULT_LOCALE, type Locale } from "@/i18n/types";

const locale = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const team = getTeam(locale);
---

<section class="py-16" id="equipo">
  <div class="mx-auto max-w-(--container-page) px-4 sm:px-6 lg:px-8">
    <SectionTitle
      eyebrow={t("team.eyebrow")}
      title={t("team.title")}
      description={t("team.description")}
    />

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {team.map((member) => <TeamCard member={member} />)}
    </div>
  </div>
</section>

<script>
  function toggleFlip(trigger: Element) {
    const card = trigger.closest("[data-team-flip]");
    if (!card) return;

    const isFlipped = card.getAttribute("data-flipped") === "true";
    card.setAttribute("data-flipped", String(!isFlipped));

    const frontFace = card.querySelector('[data-team-flip-face="front"]');
    const backFace = card.querySelector('[data-team-flip-face="back"]');
    frontFace?.setAttribute("aria-expanded", String(!isFlipped));
    frontFace?.toggleAttribute("inert", !isFlipped);
    backFace?.toggleAttribute("inert", isFlipped);
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element) || target.closest("a")) return;

    const trigger = target.closest("[data-team-flip-toggle]");
    if (trigger) toggleFlip(trigger);
  });
</script>
