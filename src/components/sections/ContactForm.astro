---
import { Icon } from "astro-icon/components";
import Button from "@/components/ui/Button.astro";

const services = [
  "Desarrollo de software a medida",
  "Infraestructura y arquitectura cloud",
  "Inteligencia artificial aplicada",
  "Modernización de plataformas",
  "Sistemas empresariales",
  "Otro",
];

const inputClasses =
  "rounded-md border border-ink-600 bg-ink-900/60 px-4 py-2.5 text-sm text-ink-50 placeholder:text-ink-500 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-400/30 aria-[invalid=true]:border-danger-400 aria-[invalid=true]:focus:border-danger-400 aria-[invalid=true]:focus:ring-danger-400/30";
---

<section class="relative overflow-hidden py-24" id="contacto">
  <div class="pointer-events-none absolute bottom-0 right-0 size-[28rem] rounded-full bg-brand-500/10 blur-[120px]"></div>
  <div class="pointer-events-none absolute top-0 left-0 size-[24rem] rounded-full bg-gold-400/10 blur-[120px]"></div>

  <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-xl border border-ink-700 bg-ink-800/40 p-6 backdrop-blur-xl sm:p-10">
      <!--
        Sin backend todavía: el formulario queda listo para integrarse con
        cualquier servicio (endpoint propio, Formspree, AWS Lambda, etc.)
        apuntando a PUBLIC_CONTACT_ENDPOINT y sustituyendo el setTimeout
        simulado del script por un fetch real. El campo honeypot ("website")
        debe seguir descartándose también en el backend, no solo aquí.
      -->
      <form id="contact-form" class="grid grid-cols-1 gap-5 sm:grid-cols-2" novalidate>
        <div class="hidden" aria-hidden="true">
          <label for="website">Deja este campo vacío</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-col gap-2">
          <label for="name" class="font-mono text-xs uppercase tracking-wider text-ink-400">Nombre *</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="name-error"
            autocomplete="name"
            placeholder="Tu nombre completo"
            class={inputClasses}
          />
          <p id="name-error" data-error-for="name" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2">
          <label for="company" class="font-mono text-xs uppercase tracking-wider text-ink-400">Empresa *</label>
          <input
            id="company"
            name="company"
            type="text"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="company-error"
            autocomplete="organization"
            placeholder="Nombre de tu empresa"
            class={inputClasses}
          />
          <p id="company-error" data-error-for="company" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2">
          <label for="email" class="font-mono text-xs uppercase tracking-wider text-ink-400">Email de trabajo *</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="email-error"
            autocomplete="email"
            placeholder="tu@empresa.com"
            class={inputClasses}
          />
          <p id="email-error" data-error-for="email" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2">
          <label for="phone" class="font-mono text-xs uppercase tracking-wider text-ink-400">Teléfono *</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="phone-error"
            autocomplete="tel"
            inputmode="tel"
            pattern="[0-9+()\s-]{7,20}"
            placeholder="+1 (555) 000-0000"
            class={inputClasses}
          />
          <p id="phone-error" data-error-for="phone" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2 sm:col-span-2">
          <label for="service" class="font-mono text-xs uppercase tracking-wider text-ink-400">Servicio de interés *</label>
          <select
            id="service"
            name="service"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="service-error"
            class={inputClasses}
          >
            <option value="" selected disabled>
              Selecciona un servicio
            </option>
            {services.map((service) => <option value={service}>{service}</option>)}
          </select>
          <p id="service-error" data-error-for="service" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2 sm:col-span-2">
          <label for="message" class="font-mono text-xs uppercase tracking-wider text-ink-400">
            Descripción del proyecto *
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="message-error"
            minlength="20"
            placeholder="Cuéntanos brevemente tu necesidad técnica, plazos y alcance estimado..."
            class:list={["resize-none", inputClasses]}
          ></textarea>
          <p id="message-error" data-error-for="message" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="sm:col-span-2">
          <Button type="submit" size="lg" class="w-full justify-center">
            <Icon name="lucide:loader-2" class="hidden size-4 animate-spin" data-submit-spinner />
            <span data-submit-label>Enviar solicitud</span>
          </Button>
          <p data-form-status class="mt-3 hidden text-center text-sm" role="status"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const status = document.querySelector<HTMLParagraphElement>("[data-form-status]");
    const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = form?.querySelector<HTMLElement>("[data-submit-label]");
    const submitSpinner = form?.querySelector<HTMLElement>("[data-submit-spinner]");
    if (!form || !status) return;

    const requiredFieldNames = ["name", "company", "email", "phone", "service", "message"] as const;
    type RequiredField = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

    function getField(name: string): RequiredField | null {
      const field = form?.elements.namedItem(name);
      return field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement
        ? field
        : null;
    }

    function getErrorMessage(field: RequiredField) {
      const validity = field.validity;
      if (validity.valueMissing) return "Este campo es obligatorio.";
      if (validity.typeMismatch) return "Ingresa un email válido.";
      if (validity.patternMismatch) return "Ingresa solo números (puedes usar +, espacios, paréntesis o guiones).";
      if (validity.tooShort) return `Escribe al menos ${(field as HTMLInputElement).minLength} caracteres.`;
      return field.validationMessage || "Revisa este campo.";
    }

    function validateField(field: RequiredField) {
      const isValid = field.checkValidity();
      field.setAttribute("aria-invalid", String(!isValid));
      const errorEl = document.getElementById(`${field.name}-error`);
      if (errorEl) {
        errorEl.textContent = isValid ? "" : getErrorMessage(field);
        errorEl.classList.toggle("hidden", isValid);
      }
      return isValid;
    }

    requiredFieldNames.forEach((name) => {
      const field = getField(name);
      if (!field) return;
      field.addEventListener("blur", () => validateField(field));
      const liveEvent = field instanceof HTMLSelectElement ? "change" : "input";
      field.addEventListener(liveEvent, () => {
        if (field.getAttribute("aria-invalid") === "true") validateField(field);
      });
    });

    function setLoading(isLoading: boolean) {
      if (submitButton) submitButton.disabled = isLoading;
      submitSpinner?.classList.toggle("hidden", !isLoading);
      if (submitLabel) submitLabel.textContent = isLoading ? "Enviando…" : "Enviar solicitud";
    }

    function showStatus(kind: "success" | "error") {
      if (!status) return;
      status.textContent =
        kind === "success"
          ? "¡Gracias por escribirnos! Un miembro de nuestro equipo revisará tu solicitud y se pondrá en contacto contigo pronto."
          : "Revisa los campos marcados antes de enviar.";
      status.classList.remove("hidden", "text-brand-300", "text-danger-400");
      status.classList.add(kind === "success" ? "text-brand-300" : "text-danger-400");
      status.setAttribute("role", kind === "success" ? "status" : "alert");
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      status.classList.add("hidden");

      const honeypot = getField("website") as HTMLInputElement | null;
      if (honeypot && honeypot.value.trim() !== "") {
        // Campo trampa lleno = bot. Fingir éxito sin enviar nada.
        form.reset();
        showStatus("success");
        return;
      }

      let firstInvalid: RequiredField | null = null;
      requiredFieldNames.forEach((name) => {
        const field = getField(name);
        if (!field) return;
        const isValid = validateField(field);
        if (!isValid && !firstInvalid) firstInvalid = field;
      });

      if (firstInvalid) {
        (firstInvalid as RequiredField).focus();
        showStatus("error");
        return;
      }

      setLoading(true);
      // TODO: sustituir por un fetch real a PUBLIC_CONTACT_ENDPOINT.
      window.setTimeout(() => {
        form.reset();
        requiredFieldNames.forEach((name) => getField(name)?.setAttribute("aria-invalid", "false"));
        setLoading(false);
        showStatus("success");
      }, 700);
    });
  });
</script>
