---
import { Icon } from "astro-icon/components";
import Button from "@/components/ui/Button.astro";
import { useTranslations } from "@/i18n/utils";
import { DEFAULT_LOCALE, type Locale } from "@/i18n/types";

const locale = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT;

const services = [
  t("contact.services.custom"),
  t("contact.services.cloud"),
  t("contact.services.ai"),
  t("contact.services.modernization"),
  t("contact.services.enterprise"),
  t("contact.services.other"),
];

const scriptI18n = {
  required: t("contact.error.required"),
  email: t("contact.error.email"),
  phonePattern: t("contact.error.phonePattern"),
  minLength: t("contact.error.minLength"),
  generic: t("contact.error.generic"),
  statusSuccess: t("contact.status.success"),
  statusError: t("contact.status.error"),
  submitLabel: t("contact.form.submit"),
  submittingLabel: t("contact.form.submitting"),
};

// text-base (16px) en mobile, no text-sm (14px): iOS Safari hace zoom automático
// al enfocar cualquier input/select/textarea con font-size menor a 16px — pasa
// justo al fallar la validación y hacer focus() en el primer campo inválido.
const inputClasses =
  "rounded-md border border-ink-600 bg-ink-900/60 px-4 py-2.5 text-base sm:text-sm text-ink-50 placeholder:text-ink-500 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-400/30 aria-[invalid=true]:border-danger-400 aria-[invalid=true]:focus:border-danger-400 aria-[invalid=true]:focus:ring-danger-400/30";
---

<section class="relative overflow-hidden py-24" id="contacto">
  <div class="pointer-events-none absolute bottom-0 right-0 size-[28rem] rounded-full bg-brand-500/10 blur-[120px]"></div>
  <div class="pointer-events-none absolute top-0 left-0 size-[24rem] rounded-full bg-gold-400/10 blur-[120px]"></div>

  <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-xl border border-ink-700 bg-ink-800/40 p-6 backdrop-blur-xl sm:p-10">
      <!--
        Envía directo a Formspree (PUBLIC_CONTACT_ENDPOINT) — solución
        temporal mientras se monta el correo corporativo en Zoho, ver
        CLAUDE.md § Historial de decisiones. Sin backend propio: el
        honeypot ("website") solo se valida acá, del lado del cliente.
      -->
      <form id="contact-form" class="grid grid-cols-1 gap-5 sm:grid-cols-2" novalidate>
        <div class="hidden" aria-hidden="true">
          <label for="website">{t("contact.form.honeypotLabel")}</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-col gap-2">
          <label for="name" class="font-mono text-xs uppercase tracking-wider text-ink-400">{t("contact.form.name")} *</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="name-error"
            autocomplete="name"
            placeholder={t("contact.form.placeholder.name")}
            class={inputClasses}
          />
          <p id="name-error" data-error-for="name" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2">
          <label for="company" class="font-mono text-xs uppercase tracking-wider text-ink-400">{t("contact.form.company")} *</label>
          <input
            id="company"
            name="company"
            type="text"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="company-error"
            autocomplete="organization"
            placeholder={t("contact.form.placeholder.company")}
            class={inputClasses}
          />
          <p id="company-error" data-error-for="company" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2">
          <label for="email" class="font-mono text-xs uppercase tracking-wider text-ink-400">{t("contact.form.email")} *</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="email-error"
            autocomplete="email"
            placeholder={t("contact.form.placeholder.email")}
            class={inputClasses}
          />
          <p id="email-error" data-error-for="email" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2">
          <label for="phone" class="font-mono text-xs uppercase tracking-wider text-ink-400">{t("contact.form.phone")} *</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="phone-error"
            autocomplete="tel"
            inputmode="tel"
            pattern="[0-9+()\s-]{7,20}"
            placeholder={t("contact.form.placeholder.phone")}
            class={inputClasses}
          />
          <p id="phone-error" data-error-for="phone" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2 sm:col-span-2">
          <label for="service" class="font-mono text-xs uppercase tracking-wider text-ink-400">{t("contact.form.service")} *</label>
          <select
            id="service"
            name="service"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="service-error"
            class={inputClasses}
          >
            <option value="" selected disabled>
              {t("contact.form.placeholder.service")}
            </option>
            {services.map((service) => <option value={service}>{service}</option>)}
          </select>
          <p id="service-error" data-error-for="service" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2 sm:col-span-2">
          <label for="message" class="font-mono text-xs uppercase tracking-wider text-ink-400">
            {t("contact.form.message")} *
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="message-error"
            minlength="20"
            placeholder={t("contact.form.placeholder.message")}
            class:list={["resize-none", inputClasses]}
          ></textarea>
          <p id="message-error" data-error-for="message" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="sm:col-span-2">
          <Button type="submit" size="lg" class="w-full justify-center">
            <Icon name="lucide:loader-2" class="hidden size-4 animate-spin" data-submit-spinner />
            <span data-submit-label>{t("contact.form.submit")}</span>
          </Button>
          <p data-form-status class="mt-3 hidden text-center text-sm" role="status"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script is:inline define:vars={{ i18n: scriptI18n, contactEndpoint }}>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form");
    const status = document.querySelector("[data-form-status]");
    const submitButton = form?.querySelector('button[type="submit"]');
    const submitLabel = form?.querySelector("[data-submit-label]");
    const submitSpinner = form?.querySelector("[data-submit-spinner]");
    if (!form || !status) return;

    const requiredFieldNames = ["name", "company", "email", "phone", "service", "message"];

    function getField(name) {
      const field = form?.elements.namedItem(name);
      return field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement
        ? field
        : null;
    }

    function getErrorMessage(field) {
      const validity = field.validity;
      if (validity.valueMissing) return i18n.required;
      if (validity.typeMismatch) return i18n.email;
      if (validity.patternMismatch) return i18n.phonePattern;
      if (validity.tooShort) return i18n.minLength.replace("{min}", String(field.minLength));
      return field.validationMessage || i18n.generic;
    }

    function validateField(field) {
      const isValid = field.checkValidity();
      field.setAttribute("aria-invalid", String(!isValid));
      const errorEl = document.getElementById(`${field.name}-error`);
      if (errorEl) {
        errorEl.textContent = isValid ? "" : getErrorMessage(field);
        errorEl.classList.toggle("hidden", isValid);
      }
      return isValid;
    }

    requiredFieldNames.forEach((name) => {
      const field = getField(name);
      if (!field) return;
      field.addEventListener("blur", () => validateField(field));
      const liveEvent = field instanceof HTMLSelectElement ? "change" : "input";
      field.addEventListener(liveEvent, () => {
        if (field.getAttribute("aria-invalid") === "true") validateField(field);
      });
    });

    function setLoading(isLoading) {
      if (submitButton) submitButton.disabled = isLoading;
      submitSpinner?.classList.toggle("hidden", !isLoading);
      if (submitLabel) submitLabel.textContent = isLoading ? i18n.submittingLabel : i18n.submitLabel;
    }

    function showStatus(kind) {
      if (!status) return;
      status.textContent = kind === "success" ? i18n.statusSuccess : i18n.statusError;
      status.classList.remove("hidden", "text-brand-300", "text-danger-400");
      status.classList.add(kind === "success" ? "text-brand-300" : "text-danger-400");
      status.setAttribute("role", kind === "success" ? "status" : "alert");
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      status.classList.add("hidden");

      const honeypot = getField("website");
      if (honeypot && honeypot.value.trim() !== "") {
        // Campo trampa lleno = bot. Fingir éxito sin enviar nada.
        form.reset();
        showStatus("success");
        return;
      }

      let firstInvalid = null;
      requiredFieldNames.forEach((name) => {
        const field = getField(name);
        if (!field) return;
        const isValid = validateField(field);
        if (!isValid && !firstInvalid) firstInvalid = field;
      });

      if (firstInvalid) {
        firstInvalid.focus();
        showStatus("error");
        return;
      }

      if (!contactEndpoint) {
        showStatus("error");
        return;
      }

      setLoading(true);

      const formData = new FormData(form);
      formData.delete("website"); // honeypot: ya validado arriba, no hace falta mandarlo
      const body = Object.fromEntries(formData.entries());

      fetch(contactEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(body),
      })
        .then((response) => {
          if (!response.ok) throw new Error("request_failed");
          form.reset();
          requiredFieldNames.forEach((name) => getField(name)?.setAttribute("aria-invalid", "false"));
          showStatus("success");
        })
        .catch(() => {
          showStatus("error");
        })
        .finally(() => {
          setLoading(false);
        });
    });
  });
</script>
