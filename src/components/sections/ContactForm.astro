---
import { Icon } from "astro-icon/components";
import Button from "@/components/ui/Button.astro";
import { localizedHref, useTranslations } from "@/i18n/utils";
import { DEFAULT_LOCALE, type Locale } from "@/i18n/types";
import { withBase } from "@/utils/url";

const locale = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
// El envío lo hace la Pages Function de functions/api/contact.ts (Turnstile +
// Resend) — ver CLAUDE.md § Formulario de contacto. La site key de Turnstile es
// pública por diseño; la clave secreta solo existe del lado de la función.
const contactEndpoint = withBase("/api/contact");
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const privacyHref = withBase(localizedHref("/legal/privacidad", locale));

const services = [
  t("contact.services.custom"),
  t("contact.services.cloud"),
  t("contact.services.ai"),
  t("contact.services.modernization"),
  t("contact.services.enterprise"),
  t("contact.services.other"),
];

const scriptI18n = {
  required: t("contact.error.required"),
  email: t("contact.error.email"),
  phonePattern: t("contact.error.phonePattern"),
  minLength: t("contact.error.minLength"),
  generic: t("contact.error.generic"),
  consent: t("contact.error.consent"),
  statusSuccess: t("contact.status.success"),
  statusError: t("contact.status.error"),
  statusCaptcha: t("contact.status.captcha"),
  statusSendError: t("contact.status.sendError"),
  submitLabel: t("contact.form.submit"),
  submittingLabel: t("contact.form.submitting"),
};

const inputClasses =
  "rounded-md border border-ink-600 bg-ink-900/60 px-4 py-2.5 text-sm text-ink-50 placeholder:text-ink-500 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-400/30 aria-[invalid=true]:border-danger-400 aria-[invalid=true]:focus:border-danger-400 aria-[invalid=true]:focus:ring-danger-400/30";
---

<section class="relative overflow-hidden py-24" id="contacto">
  <div class="pointer-events-none absolute bottom-0 right-0 size-[28rem] rounded-full bg-brand-500/10 blur-[120px]"></div>
  <div class="pointer-events-none absolute top-0 left-0 size-[24rem] rounded-full bg-gold-400/10 blur-[120px]"></div>

  <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-xl border border-ink-700 bg-ink-800/40 p-6 backdrop-blur-xl sm:p-10">
      <!--
        Envía a la Pages Function /api/contact (functions/api/contact.ts), que
        revalida todo del lado del servidor (campos, honeypot, token de
        Turnstile) y manda la notificación por Resend a CONTACT_TO.
      -->
      <form
        id="contact-form"
        class="grid grid-cols-1 gap-5 sm:grid-cols-2"
        novalidate
        data-contact-form
        data-endpoint={contactEndpoint}
        data-turnstile-site-key={turnstileSiteKey}
        data-locale={locale}
        data-i18n={JSON.stringify(scriptI18n)}
      >
        <div class="hidden" aria-hidden="true">
          <label for="website">{t("contact.form.honeypotLabel")}</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-col gap-2">
          <label for="name" class="font-mono text-xs uppercase tracking-wider text-ink-400">{t("contact.form.name")} *</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="name-error"
            autocomplete="name"
            placeholder={t("contact.form.placeholder.name")}
            class={inputClasses}
          />
          <p id="name-error" data-error-for="name" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2">
          <label for="company" class="font-mono text-xs uppercase tracking-wider text-ink-400">{t("contact.form.company")} *</label>
          <input
            id="company"
            name="company"
            type="text"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="company-error"
            autocomplete="organization"
            placeholder={t("contact.form.placeholder.company")}
            class={inputClasses}
          />
          <p id="company-error" data-error-for="company" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2">
          <label for="email" class="font-mono text-xs uppercase tracking-wider text-ink-400">{t("contact.form.email")} *</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="email-error"
            autocomplete="email"
            placeholder={t("contact.form.placeholder.email")}
            class={inputClasses}
          />
          <p id="email-error" data-error-for="email" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2">
          <label for="phone" class="font-mono text-xs uppercase tracking-wider text-ink-400">{t("contact.form.phone")} *</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="phone-error"
            autocomplete="tel"
            inputmode="tel"
            pattern="[0-9+()\s-]{7,20}"
            placeholder={t("contact.form.placeholder.phone")}
            class={inputClasses}
          />
          <p id="phone-error" data-error-for="phone" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2 sm:col-span-2">
          <label for="service" class="font-mono text-xs uppercase tracking-wider text-ink-400">{t("contact.form.service")} *</label>
          <select
            id="service"
            name="service"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="service-error"
            class={inputClasses}
          >
            <option value="" selected disabled>
              {t("contact.form.placeholder.service")}
            </option>
            {services.map((service) => <option value={service}>{service}</option>)}
          </select>
          <p id="service-error" data-error-for="service" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="flex flex-col gap-2 sm:col-span-2">
          <label for="message" class="font-mono text-xs uppercase tracking-wider text-ink-400">
            {t("contact.form.message")} *
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="message-error"
            minlength="20"
            placeholder={t("contact.form.placeholder.message")}
            class:list={["resize-none", inputClasses]}
          ></textarea>
          <p id="message-error" data-error-for="message" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <!--
          Autorización de tratamiento de datos (Ley 1581 de 2012: previa, expresa e
          informada). Obligatoria — la función la revalida y deja constancia en el
          correo de notificación, que sirve como prueba de la autorización.
        -->
        <div class="flex flex-col gap-2 sm:col-span-2">
          <div class="flex items-start gap-3">
            <input
              id="privacyConsent"
              name="privacyConsent"
              type="checkbox"
              required
              aria-required="true"
              aria-invalid="false"
              aria-describedby="privacyConsent-error"
              class="mt-0.5 size-4 shrink-0 cursor-pointer accent-brand-400 aria-[invalid=true]:outline-2 aria-[invalid=true]:outline-offset-2 aria-[invalid=true]:outline-danger-400"
            />
            <label for="privacyConsent" class="cursor-pointer text-sm leading-relaxed text-ink-300">
              {t("contact.form.consentLabel")}
              <a href={privacyHref} target="_blank" rel="noopener" class="text-brand-400 underline-offset-2 hover:underline"
                >{t("contact.form.consentLink")}</a
              >. *
            </label>
          </div>
          <p id="privacyConsent-error" data-error-for="privacyConsent" class="hidden text-xs text-danger-400" role="alert"></p>
        </div>

        <div class="sm:col-span-2">
          <!-- Turnstile (antispam de Cloudflare) se renderiza acá desde el script; agrega solo el input oculto cf-turnstile-response. -->
          <div data-turnstile-container class="mb-4 min-h-[65px]"></div>
          <Button type="submit" size="lg" class="w-full justify-center">
            <Icon name="lucide:loader-2" class="hidden size-4 animate-spin" data-submit-spinner />
            <span data-submit-label>{t("contact.form.submit")}</span>
          </Button>
          <p data-form-status class="mt-3 hidden text-center text-sm" role="status"></p>
        </div>
      </form>
    </div>
  </div>
</section>


<script>
  // Script empaquetado (no is:inline): Astro lo ejecuta una sola vez aunque haya
  // navegaciones con <ClientRouter />. Toda la configuración por página (textos
  // ES/EN, endpoint, site key) se lee de los data-* del <form> actual en cada
  // astro:page-load, y data-contact-ready evita enlazar dos veces el mismo form
  // — con el is:inline + define:vars anterior, cada navegación sumaba otro
  // listener de submit y un solo clic podía mandar el correo varias veces.

  interface ContactI18n {
    required: string;
    email: string;
    phonePattern: string;
    minLength: string;
    generic: string;
    consent: string;
    statusSuccess: string;
    statusError: string;
    statusCaptcha: string;
    statusSendError: string;
    submitLabel: string;
    submittingLabel: string;
  }

  interface TurnstileApi {
    render: (container: HTMLElement, options: Record<string, unknown>) => string | undefined;
    reset: (widgetId?: string) => void;
  }

  type FormField = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  type StatusKind = "success" | "invalid" | "captcha" | "sendError";

  const TURNSTILE_SRC = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
  const requiredFieldNames = ["name", "company", "email", "phone", "service", "message", "privacyConsent"];

  let turnstileLoader: Promise<TurnstileApi> | null = null;

  function loadTurnstile(): Promise<TurnstileApi> {
    const existing = (window as unknown as { turnstile?: TurnstileApi }).turnstile;
    if (existing) return Promise.resolve(existing);
    turnstileLoader ??= new Promise<TurnstileApi>((resolve, reject) => {
      const script = document.createElement("script");
      script.src = TURNSTILE_SRC;
      script.async = true;
      script.onload = () => {
        const api = (window as unknown as { turnstile?: TurnstileApi }).turnstile;
        if (api) resolve(api);
        else reject(new Error("turnstile_unavailable"));
      };
      script.onerror = () => {
        turnstileLoader = null; // permitir reintentar en la próxima navegación
        reject(new Error("turnstile_load_failed"));
      };
      document.head.appendChild(script);
    });
    return turnstileLoader;
  }

  function setupContactForm(form: HTMLFormElement) {
    if (form.dataset.contactReady === "true") return;
    form.dataset.contactReady = "true";

    const i18n = JSON.parse(form.dataset.i18n ?? "{}") as ContactI18n;
    const endpoint = form.dataset.endpoint ?? "";
    const siteKey = form.dataset.turnstileSiteKey ?? "";
    const locale = form.dataset.locale === "en" ? "en" : "es";

    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const submitSpinner = form.querySelector<HTMLElement>("[data-submit-spinner]");
    const turnstileContainer = form.querySelector<HTMLElement>("[data-turnstile-container]");

    let turnstile: TurnstileApi | null = null;
    let widgetId: string | undefined;

    if (siteKey && turnstileContainer) {
      loadTurnstile()
        .then((api) => {
          // Si el usuario ya navegó a otra página, el form quedó fuera del DOM.
          if (!turnstileContainer.isConnected) return;
          turnstile = api;
          widgetId = api.render(turnstileContainer, {
            sitekey: siteKey,
            language: locale,
            theme: document.documentElement.dataset.theme === "light" ? "light" : "dark",
            size: "flexible",
          });
        })
        .catch(() => {
          // Sin Turnstile el servidor rechaza el envío; se informa al intentar enviar.
        });
    }

    function getField(name: string): FormField | null {
      const field = form.elements.namedItem(name);
      return field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement
        ? field
        : null;
    }

    function getErrorMessage(field: FormField): string {
      const validity = field.validity;
      if (validity.valueMissing && field instanceof HTMLInputElement && field.type === "checkbox") return i18n.consent;
      if (validity.valueMissing) return i18n.required;
      if (validity.typeMismatch) return i18n.email;
      if (validity.patternMismatch) return i18n.phonePattern;
      if (validity.tooShort && field instanceof HTMLTextAreaElement) {
        return i18n.minLength.replace("{min}", String(field.minLength));
      }
      return field.validationMessage || i18n.generic;
    }

    function validateField(field: FormField): boolean {
      const isValid = field.checkValidity();
      field.setAttribute("aria-invalid", String(!isValid));
      const errorEl = document.getElementById(`${field.name}-error`);
      if (errorEl) {
        errorEl.textContent = isValid ? "" : getErrorMessage(field);
        errorEl.classList.toggle("hidden", isValid);
      }
      return isValid;
    }

    requiredFieldNames.forEach((name) => {
      const field = getField(name);
      if (!field) return;
      field.addEventListener("blur", () => validateField(field));
      const usesChange = field instanceof HTMLSelectElement || (field instanceof HTMLInputElement && field.type === "checkbox");
      const liveEvent = usesChange ? "change" : "input";
      field.addEventListener(liveEvent, () => {
        if (field.getAttribute("aria-invalid") === "true") validateField(field);
      });
    });

    function setLoading(isLoading: boolean) {
      if (submitButton) submitButton.disabled = isLoading;
      submitSpinner?.classList.toggle("hidden", !isLoading);
      if (submitLabel) submitLabel.textContent = isLoading ? i18n.submittingLabel : i18n.submitLabel;
    }

    function showStatus(kind: StatusKind) {
      if (!status) return;
      const messages: Record<StatusKind, string> = {
        success: i18n.statusSuccess,
        invalid: i18n.statusError,
        captcha: i18n.statusCaptcha,
        sendError: i18n.statusSendError,
      };
      const isSuccess = kind === "success";
      status.textContent = messages[kind];
      status.classList.remove("hidden", "text-brand-300", "text-danger-400");
      status.classList.add(isSuccess ? "text-brand-300" : "text-danger-400");
      status.setAttribute("role", isSuccess ? "status" : "alert");
    }

    function resetTurnstile() {
      // Cada token sirve para una sola verificación: después de cualquier
      // intento (exitoso o no) hay que pedir uno nuevo.
      if (turnstile && widgetId !== undefined) turnstile.reset(widgetId);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      status?.classList.add("hidden");

      const honeypot = getField("website");
      if (honeypot && honeypot.value.trim() !== "") {
        // Campo trampa lleno = bot. Fingir éxito sin enviar nada.
        form.reset();
        showStatus("success");
        return;
      }

      let firstInvalid: FormField | null = null;
      requiredFieldNames.forEach((name) => {
        const field = getField(name);
        if (!field) return;
        const isValid = validateField(field);
        if (!isValid && !firstInvalid) firstInvalid = field;
      });

      if (firstInvalid) {
        (firstInvalid as FormField).focus();
        showStatus("invalid");
        return;
      }

      const formData = new FormData(form);
      const token = formData.get("cf-turnstile-response");
      if (typeof token !== "string" || token === "") {
        showStatus("captcha");
        return;
      }

      setLoading(true);
      const body: Record<string, string> = { locale };
      formData.forEach((value, key) => {
        if (typeof value === "string") body[key] = value;
      });

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(body),
        });
        const result = (await response.json().catch(() => ({}))) as { ok?: boolean; error?: string };

        if (response.ok && result.ok) {
          form.reset();
          requiredFieldNames.forEach((name) => getField(name)?.setAttribute("aria-invalid", "false"));
          showStatus("success");
        } else if (result.error === "invalid_fields") {
          showStatus("invalid");
        } else if (result.error === "captcha_failed") {
          showStatus("captcha");
        } else {
          showStatus("sendError");
        }
      } catch {
        showStatus("sendError");
      } finally {
        resetTurnstile();
        setLoading(false);
      }
    });
  }

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLFormElement>("form[data-contact-form]").forEach(setupContactForm);
  });
</script>
