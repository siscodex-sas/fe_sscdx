---
import ServiceCard from "@/components/sections/ServiceCard.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { getServices } from "@/data/services";
import { useTranslations } from "@/i18n/utils";
import { DEFAULT_LOCALE, type Locale } from "@/i18n/types";

const locale = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const services = getServices(locale);
---

<section class="py-24" id="servicios">
  <div class="mx-auto max-w-(--container-page) px-4 sm:px-6 lg:px-8">
    <SectionTitle
      eyebrow={t("services.eyebrow")}
      title={t("services.title")}
      description={t("services.description")}
    />

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </div>
</section>
