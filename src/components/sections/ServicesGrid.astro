---
import ServiceCard from "@/components/sections/ServiceCard.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { services } from "@/data/services";
---

<section class="py-24" id="servicios">
  <div class="mx-auto max-w-(--container-page) px-4 sm:px-6 lg:px-8">
    <SectionTitle
      eyebrow="Servicios"
      title="Soluciones de ingeniería para cada etapa de tu producto"
      description="Desde el primer prototipo hasta la operación a escala, cubrimos todo el ciclo de vida del software empresarial."
    />

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </div>
</section>
