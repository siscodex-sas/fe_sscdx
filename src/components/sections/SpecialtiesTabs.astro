---
import { Icon } from "astro-icon/components";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { projects } from "@/data/projects";
import type { Project } from "@/types";

const categoryIcon: Record<Project["category"], string> = {
  web: "layout-panel-left",
  cloud: "cloud",
  ia: "brain-circuit",
  mobile: "smartphone",
  health: "heart-pulse",
};
---

<section class="border-y border-ink-700 bg-ink-900/60 py-24" id="soluciones">
  <div class="mx-auto max-w-(--container-page) px-4 sm:px-6 lg:px-8">
    <SectionTitle
      eyebrow="Soluciones"
      title="Especialización respaldada por experiencia real"
      description="Nuestra experiencia en distintas industrias nos permite combinar ingeniería de software, arquitectura cloud e inteligencia artificial para transformar desafíos complejos en soluciones eficientes, escalables y de alto impacto."
    />

    <div data-specialty-tabs class="mt-12">
      <div role="tablist" class="flex flex-wrap gap-2 border-b border-ink-700 pb-4">
        {
          projects.map((project, i) => (
            <button
              type="button"
              role="tab"
              id={`specialty-tab-${project.slug}`}
              aria-controls={`specialty-panel-${project.slug}`}
              aria-selected={i === 0 ? "true" : "false"}
              data-specialty-tab={project.slug}
              class:list={[
                "rounded-md px-4 py-2 font-mono text-sm transition-colors",
                i === 0 ? "bg-brand-400/10 text-brand-300" : "text-ink-400 hover:text-ink-100",
              ]}
            >
              {project.title}
            </button>
          ))
        }
      </div>

      <div data-specialty-panels class="mt-10">
        {
          projects.map((project, i) => (
            <div
              id={`specialty-panel-${project.slug}`}
              role="tabpanel"
              aria-labelledby={`specialty-tab-${project.slug}`}
              data-specialty-panel={project.slug}
              class:list={["", i !== 0 && "hidden"]}
            >
              <div class="grid grid-cols-1 gap-8 lg:grid-cols-[16rem_1fr] lg:items-center">
                <div
                  class="flex aspect-square items-center justify-center justify-self-center overflow-hidden rounded-xl border border-ink-700 bg-ink-900/80 lg:aspect-square lg:h-56 lg:w-56"
                  style="background-image: radial-gradient(circle at center, color-mix(in srgb, var(--color-brand-400) 10%, transparent) 0%, transparent 70%), linear-gradient(color-mix(in srgb, var(--color-ink-500) 35%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--color-ink-500) 35%, transparent) 1px, transparent 1px); background-size: 100% 100%, 20px 20px, 20px 20px;"
                >
                  <div class="flex size-28 items-center justify-center rounded-full border border-brand-400/30 bg-ink-950/80 shadow-[0_0_40px_-10px_var(--color-brand-400)]">
                    <Icon name={`lucide:${categoryIcon[project.category]}`} class="size-12 text-brand-400" />
                  </div>
                </div>
                <div>
                  <p class="max-w-2xl text-base text-ink-300">{project.summary}</p>

                  <p class="mt-6 font-mono text-xs uppercase tracking-[0.15em] text-brand-400">Qué incluye</p>
                  <ul class="mt-3 flex flex-col gap-2 text-sm text-ink-200">
                    {project.capabilities.map((capability) => (
                      <li class="flex items-baseline gap-2">
                        <span class="text-brand-400/70">–</span>
                        {capability}
                      </li>
                    ))}
                  </ul>

                  <p class="mt-6 font-mono text-xs uppercase tracking-[0.15em] text-brand-400">Para quién es esto</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {project.idealFor.map((audience) => (
                      <span class="rounded-md border border-ink-600 px-2.5 py-1 text-xs text-ink-300">{audience}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;
    const tab = target instanceof Element ? target.closest("[data-specialty-tab]") : null;
    if (!tab) return;

    const root = tab.closest("[data-specialty-tabs]");
    const slug = tab.getAttribute("data-specialty-tab");
    if (!root || !slug) return;

    root.querySelectorAll("[data-specialty-tab]").forEach((btn) => {
      const isActive = btn === tab;
      btn.classList.toggle("bg-brand-400/10", isActive);
      btn.classList.toggle("text-brand-300", isActive);
      btn.classList.toggle("text-ink-400", !isActive);
      btn.setAttribute("aria-selected", String(isActive));
    });

    root.querySelectorAll("[data-specialty-panel]").forEach((panel) => {
      panel.classList.toggle("hidden", panel.getAttribute("data-specialty-panel") !== slug);
    });
  });
</script>
