---
import { Icon } from "astro-icon/components";
import { getMainNavAnchors, getMainNavPages } from "@/data/navigation";
import Button from "@/components/ui/Button.astro";
import LanguageSwitcher from "@/components/ui/LanguageSwitcher.astro";
import ThemeToggle from "@/components/ui/ThemeToggle.astro";
import { withBase } from "@/utils/url";
import { localizedHref, useTranslations } from "@/i18n/utils";
import { DEFAULT_LOCALE, type Locale } from "@/i18n/types";

interface Props {
  /** Ruta canónica de la página actual (prop `path` de `BaseLayout`), para el selector de idioma. */
  pagePath: string;
}

const { pagePath } = Astro.props;
const locale = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const mainNavAnchors = getMainNavAnchors(locale);
const mainNavPages = getMainNavPages(locale);

const currentPath = new URL(Astro.request.url).pathname;
---

<header
  id="navbar"
  class="fixed inset-x-0 top-0 z-50 border-b border-ink-800/70 bg-ink-950/75 backdrop-blur-xl transition-shadow duration-300"
  data-navbar
>
  <nav class="mx-auto flex h-18 max-w-(--container-page) items-center justify-between overflow-hidden px-4 sm:px-6 lg:px-8">
    <a href={withBase(localizedHref("/", locale))} class="flex shrink-0 items-center">
      <img src={withBase("/logo.png")} alt="Siscodex" width="182" height="20" class="site-logo h-5 w-auto sm:h-6" />
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        mainNavAnchors.map((link) => {
          const anchorPath = withBase(localizedHref(link.href.split("#")[0] || "/", locale));
          const isActive = currentPath === anchorPath;
          return (
            <a
              href={withBase(localizedHref(link.href, locale))}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "text-sm font-medium text-ink-300 transition-colors duration-200 hover:text-brand-300",
                isActive && "text-brand-300",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }

      <span class="text-ink-700" aria-hidden="true">|</span>

      {
        mainNavPages.map((link) => {
          const linkHref = withBase(localizedHref(link.href, locale));
          return (
            <a
              href={linkHref}
              aria-current={currentPath === linkHref ? "page" : undefined}
              class:list={[
                "text-sm font-medium text-ink-300 transition-colors duration-200 hover:text-brand-300",
                currentPath === linkHref && "text-brand-300",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </div>

    <div class="flex items-center gap-3">
      <ThemeToggle class="hidden md:inline-flex" />
      <LanguageSwitcher pagePath={pagePath} class="hidden md:inline-flex" />
      <Button href="/contacto" size="md" class="hidden md:inline-flex">{t("nav.cta")}</Button>
      <button
        type="button"
        aria-label={t("nav.aria.menu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
        class="inline-flex size-10 items-center justify-center rounded-md text-ink-100 md:hidden"
      >
        <Icon name="lucide:menu" class="size-6" data-menu-icon-open />
        <Icon name="lucide:x" class="hidden size-6" data-menu-icon-close />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-ink-700 bg-ink-950/98 backdrop-blur-xl md:hidden">
    <div class="flex flex-col gap-1 px-4 py-4">
      {
        mainNavAnchors.map((link) => (
          <a
            href={withBase(localizedHref(link.href, locale))}
            class="rounded-md px-3 py-3 text-base font-medium text-ink-200 hover:bg-ink-800 hover:text-brand-300"
          >
            {link.label}
          </a>
        ))
      }

      <hr class="my-1 border-ink-700" />

      {
        mainNavPages.map((link) => (
          <a
            href={withBase(localizedHref(link.href, locale))}
            class="rounded-md px-3 py-3 text-base font-medium text-ink-200 hover:bg-ink-800 hover:text-brand-300"
          >
            {link.label}
          </a>
        ))
      }
      <div class="mt-2 flex items-center gap-3">
        <ThemeToggle />
        <LanguageSwitcher pagePath={pagePath} />
        <Button href="/contacto" size="md" class="flex-1 justify-center">{t("nav.cta")}</Button>
      </div>
    </div>
  </div>
</header>

<script>
  // Delegación de eventos en `document`: con las View Transitions de Astro,
  // el navbar se reemplaza por completo en cada navegación, así que fijar
  // referencias a elementos concretos una sola vez las deja "muertas" tras
  // la primera navegación. Consultando el DOM en cada evento, siempre se
  // opera sobre lo que esté visible en ese momento.
  function onScroll() {
    const navbar = document.querySelector("[data-navbar]");
    if (!navbar) return;
    const scrolled = window.scrollY > 8;
    navbar.classList.toggle("shadow-lg", scrolled);
    navbar.classList.toggle("shadow-black/20", scrolled);
  }

  function resetMobileMenu() {
    const mobileMenu = document.getElementById("mobile-menu");
    const menuToggle = document.querySelector("[data-menu-toggle]");
    const iconOpen = document.querySelector("[data-menu-icon-open]");
    const iconClose = document.querySelector("[data-menu-icon-close]");
    mobileMenu?.classList.add("hidden");
    menuToggle?.setAttribute("aria-expanded", "false");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  document.addEventListener("astro:page-load", () => {
    onScroll();
    // Si una navegación con View Transitions ocurrió con el menú abierto,
    // que la página nueva arranque siempre con el menú cerrado.
    resetMobileMenu();
  });

  document.addEventListener("click", (event) => {
    const target = event.target;
    const toggle = target instanceof Element ? target.closest("[data-menu-toggle]") : null;
    if (!toggle) return;

    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = document.querySelector("[data-menu-icon-open]");
    const iconClose = document.querySelector("[data-menu-icon-close]");

    const isOpen = mobileMenu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
    iconOpen?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
  });
</script>
