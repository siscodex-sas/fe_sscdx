---
import { ClientRouter } from "astro:transitions";
import SEO from "@/components/seo/SEO.astro";
import Navbar from "@/components/layout/Navbar.astro";
import Footer from "@/components/layout/Footer.astro";
import { withBase } from "@/utils/url";
import { DEFAULT_LOCALE, type Locale } from "@/i18n/types";
import type { SEOProps } from "@/types";
import "@/styles/global.css";

interface Props extends SEOProps {}

const { title, description, path, image, noindex } = Astro.props;
const locale = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <!--
      CSP vía meta tag: es la única forma de mandar una Content-Security-Policy
      en GitHub Pages (no permite headers HTTP custom). Debe ir lo primero
      posible en <head> — un <meta> CSP solo rige el contenido que viene
      DESPUÉS de él en el documento, no lo anterior. 'unsafe-inline' en
      script-src/style-src es necesario porque el sitio usa scripts inline
      (tema, formulario de contacto, JSON-LD) y Astro inlinea CSS pequeño —
      no hay nonce/hash posible sin un servidor que los genere por request.
      Sigue bloqueando: cualquier script/estilo/imagen/fuente de un dominio
      externo, cambios de <base>, envío de formularios a otro origen.
      `frame-ancestors` (protección contra clickjacking) NO se puede poner
      por meta tag — solo por header HTTP real, ver CLAUDE.md/ARCHITECTURE.md
      cuando el sitio tenga un CDN/servidor delante (Netlify, Cloudflare).
      Si se integra `PUBLIC_CONTACT_ENDPOINT` en otro dominio, agregarlo a
      connect-src.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <script is:inline>
      // Bloqueante a propósito: fija data-theme ANTES del primer paint para
      // que no haya un parpadeo del tema equivocado al cargar. No puede
      // importar src/scripts/theme.ts (un script inline no procesa
      // imports), así que repite el mínimo indispensable — ver esa función
      // (getStoredTheme/applyTheme) para la versión completa que sí se usa
      // en el resto del ciclo de vida de la página.
      (function () {
        var theme = "dark";
        try {
          var stored = localStorage.getItem("siscodex:theme");
          if (stored === "light" || stored === "dark") theme = stored;
        } catch (e) {}
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1a1b1e" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    <SEO title={title} description={description} path={path} image={image} noindex={noindex} />
    <ClientRouter />
  </head>
  <body>
    <Navbar pagePath={path} />
    <main id="top">
      <slot />
    </main>
    <Footer />

    <script>
      import { initScrollReveal } from "@/scripts/reveal";
      import { applyTheme, getStoredTheme, initThemePersistence } from "@/scripts/theme";

      document.addEventListener("astro:page-load", initScrollReveal);

      // Sincroniza el meta theme-color (el atributo data-theme del <html>
      // ya lo puso el script bloqueante de arriba) y deja enganchada la
      // persistencia entre navegaciones con View Transitions.
      applyTheme(getStoredTheme());
      initThemePersistence();
    </script>
  </body>
</html>
