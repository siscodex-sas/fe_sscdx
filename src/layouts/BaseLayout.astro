---
import { ClientRouter } from "astro:transitions";
import SEO from "@/components/seo/SEO.astro";
import Navbar from "@/components/layout/Navbar.astro";
import Footer from "@/components/layout/Footer.astro";
import { withBase } from "@/utils/url";
import { DEFAULT_LOCALE, type Locale } from "@/i18n/types";
import type { SEOProps } from "@/types";
import "@/styles/global.css";

interface Props extends SEOProps {}

const { title, description, path, image, noindex } = Astro.props;
const locale = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <!--
      La Content-Security-Policy, Referrer-Policy y el resto de headers de
      seguridad ya NO van acá — viven como headers HTTP reales en
      public/_headers (Cloudflare Pages los sirve tal cual). Un header real
      es estrictamente mejor que un <meta> CSP: aplica antes de que el HTML
      empiece a parsearse (no solo desde este punto en adelante) y sí puede
      incluir `frame-ancestors` (protección contra clickjacking), que por
      meta tag el navegador simplemente ignora. Si `public/_headers` cambia,
      no hace falta tocar este layout.
    -->
    <script is:inline>
      // Bloqueante a propósito: fija data-theme ANTES del primer paint para
      // que no haya un parpadeo del tema equivocado al cargar. No puede
      // importar src/scripts/theme.ts (un script inline no procesa
      // imports), así que repite el mínimo indispensable — ver esa función
      // (getStoredTheme/applyTheme) para la versión completa que sí se usa
      // en el resto del ciclo de vida de la página.
      (function () {
        var theme = "dark";
        try {
          var stored = localStorage.getItem("siscodex:theme");
          if (stored === "light" || stored === "dark") theme = stored;
        } catch (e) {}
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1a1b1e" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    <SEO title={title} description={description} path={path} image={image} noindex={noindex} />
    <ClientRouter />

    {
      gaMeasurementId && (
        <>
          {/*
            send_page_view: false — con <ClientRouter /> las navegaciones no
            recargan la página, así que gtag nunca vería la ruta nueva si
            dejáramos que 'config' mande el page_view automático solo al
            cargar. En vez de eso, se manda un evento page_view manual en
            cada astro:page-load (abajo), que cubre tanto la carga inicial
            como cada navegación SPA subsiguiente por igual.
          */}
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
          <script is:inline define:vars={{ gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaMeasurementId, { send_page_view: false });
          </script>
        </>
      )
    }
  </head>
  <body>
    <Navbar pagePath={path} />
    <main id="top">
      <slot />
    </main>
    <Footer />

    <script>
      import { initScrollReveal } from "@/scripts/reveal";
      import { applyTheme, getStoredTheme, initThemePersistence } from "@/scripts/theme";

      document.addEventListener("astro:page-load", initScrollReveal);

      // gtag se define inline en <head> solo cuando PUBLIC_GA_MEASUREMENT_ID
      // está seteado (ver comentario junto al script) — sin el chequeo,
      // esto explotaría en local/preview donde la variable no existe.
      declare global {
        interface Window {
          gtag?: (...args: unknown[]) => void;
        }
      }

      document.addEventListener("astro:page-load", () => {
        window.gtag?.("event", "page_view", {
          page_location: location.href,
          page_path: location.pathname + location.search,
          page_title: document.title,
        });
      });

      // Sincroniza el meta theme-color (el atributo data-theme del <html>
      // ya lo puso el script bloqueante de arriba) y deja enganchada la
      // persistencia entre navegaciones con View Transitions.
      applyTheme(getStoredTheme());
      initThemePersistence();
    </script>
  </body>
</html>
