---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/sections/PageHeader.astro";
import TeamSection from "@/components/sections/TeamSection.astro";
import WhyUs from "@/components/sections/WhyUs.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { Icon } from "astro-icon/components";

const values = [
  {
    icon: "target",
    title: "Enfoque en resultados",
    description: "Cada decisión técnica se evalúa por su impacto en el negocio del cliente, no por moda tecnológica.",
  },
  {
    icon: "eye",
    title: "Transparencia técnica",
    description: "Reportamos avances reales, incluyendo riesgos y bloqueos, en lugar de actualizaciones vacías.",
  },
  {
    icon: "graduation-cap",
    title: "Mejora continua",
    description: "Revisiones de código, retrospectivas y actualización constante de nuestras prácticas de ingeniería.",
  },
];
---

<BaseLayout
  title="Nosotros"
  description="Conoce al equipo de ingeniería detrás de Siscodex: nuestra misión, valores y forma de trabajar con empresas."
  path="/nosotros"
>
  <PageHeader
    eyebrow="Nosotros"
    title="El equipo detrás de cada proyecto"
    description="Quienes toman las decisiones técnicas y de negocio, sin capas intermedias — respaldados por un equipo completo detrás de cada proyecto."
  />

  <TeamSection />

  <section class="py-16">
    <div class="mx-auto max-w-(--container-page) px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
        {
          values.map((value) => (
            <div class="rounded-lg border border-ink-700 bg-ink-800/30 p-6" data-reveal>
              <div class="mb-4 flex size-11 items-center justify-center rounded-lg bg-brand-400/10 text-brand-300">
                <Icon name={`lucide:${value.icon}`} class="size-5" />
              </div>
              <h3 class="text-base font-semibold text-ink-50">{value.title}</h3>
              <p class="mt-2 text-sm text-ink-300">{value.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <WhyUs
    title="Ingeniería con visión estratégica"
    description="Siscodex ayuda a las organizaciones a crecer y evolucionar sin límites técnicos, liderando el diseño y desarrollo de soluciones de software e infraestructura cloud sólidas, escalables y preparadas para negocios en constante evolución. Combina ingeniería de alto nivel, arquitectura moderna y visión estratégica para transformar desafíos complejos en soluciones eficientes, sostenibles y de alto impacto — como un aliado tecnológico que acompaña a cada cliente desde sus retos actuales hasta sus próximos desafíos de crecimiento."
  />

  <section class="py-16">
    <div class="mx-auto max-w-2xl px-4 text-center sm:px-6 lg:px-8">
      <span class="font-mono text-3xl text-brand-400/70 sm:text-4xl">“</span>
      <p class="mt-2 text-xl leading-relaxed font-normal text-ink-200 italic sm:text-2xl">
        El verdadero valor de la tecnología no está en definir hasta dónde puede llegar una
        empresa, sino en hacer posible todo aquello que aún no ha imaginado.
      </p>
    </div>
  </section>

  <CTASection
    title="¿Listo para conversar sobre tu proyecto?"
    description="Agenda una llamada inicial sin costo, directo con el equipo de liderazgo."
  />
</BaseLayout>
