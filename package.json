    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "astro-icon": "^1.1.5",
    "motion": "^12.4.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.141.0"
  },
  "engines": {
    "node": ">=20.3.0"
